# GenerateTranslationContexts.cmake
#
# 从 TS 文件的 <name>...</name> 提取 Qt 翻译 context，生成 C++ 头文件供 TR() 查找。
#
# 输入变量：
#   OUT_HEADER  生成的 .h 路径
#   TS_FILES    .ts 文件列表（绝对路径）

if(NOT OUT_HEADER)
    message(FATAL_ERROR "GenerateTranslationContexts: OUT_HEADER is required")
endif()

set(_contexts "")
foreach(_ts IN LISTS TS_FILES)
    if(NOT EXISTS "${_ts}")
        continue()
    endif()
    file(READ "${_ts}" _content ENCODING UTF-8)
    string(REGEX MATCHALL "<name>[^<]+</name>" _name_tags "${_content}")
    foreach(_tag IN LISTS _name_tags)
        string(REGEX REPLACE "<name>([^<]+)</name>" "\\1" _ctx "${_tag}")
        list(APPEND _contexts "${_ctx}")
    endforeach()
endforeach()

list(REMOVE_DUPLICATES _contexts)

# TR() 多数 key 在 LanguageManager context，优先查找以减少 translate 调用次数
list(FIND _contexts "LanguageManager" _lm_idx)
if(_lm_idx GREATER 0)
    list(REMOVE_ITEM _contexts "LanguageManager")
    list(PREPEND _contexts "LanguageManager")
endif()

set(_header "// Auto-generated by GenerateTranslationContexts.cmake — do not edit.\n")
string(APPEND _header "#pragma once\n\n#include <QStringList>\n\n")
string(APPEND _header "namespace translation_contexts {\n\n")
string(APPEND _header "inline QStringList all()\n{\n    return {\n")

set(_count 0)
foreach(_ctx IN LISTS _contexts)
    if(_count GREATER 0)
        string(APPEND _header ",\n")
    endif()
    string(APPEND _header "        QStringLiteral(\"${_ctx}\")")
    math(EXPR _count "${_count} + 1")
endforeach()

string(APPEND _header "\n    };\n}\n\n} // namespace translation_contexts\n")

file(WRITE "${OUT_HEADER}" "${_header}")
message(STATUS "[uibase] Generated translation contexts (${_count}): ${_contexts}")
