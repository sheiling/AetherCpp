{
  "_comment": "检测工位流程 — 接收工件、AOI视觉检测、发送检测结果",
  "name":               "检测流程",
  "description":        "检测工位：接收工件 → AOI并行检测 → 发送结果到下料通道",
  "version":            1,
  "timeoutMs":          60000,
  "enableCompensation": true,
  "steps": {
    "type": "control.sequential",
    "name": "检测主流程",
    "children": [
      {
        "_comment": "从上料通道接收工件数据（阻塞等待）",
        "type":   "sync.channel_receive",
        "name":   "接收工件数据",
        "timeoutMs": 30000,
        "params": {
          "channel": "ch-load-to-inspect",
          "ctxKey":  "workpiece_data"
        }
      },
      {
        "type":    "control.script",
        "name":    "工件定位",
        "script":  "st_inspect_position",
        "timeoutMs": 3000,
        "retryCount": 1,
        "isCheckpoint": true
      },
      {
        "_comment": "并行执行多路检测（耗时较长，并行加速）",
        "type": "control.parallel",
        "name": "并行检测",
        "children": [
          {
            "type":    "control.script",
            "name":    "AOI视觉检测",
            "script":  "st_inspect_aoi",
            "timeoutMs": 15000
          },
          {
            "type":    "control.script",
            "name":    "尺寸测量",
            "script":  "st_inspect_dimension",
            "timeoutMs": 10000
          },
          {
            "type":    "control.script",
            "name":    "焊点检测",
            "script":  "st_inspect_solder",
            "timeoutMs": 12000
          }
        ]
      },
      {
        "type":    "control.script",
        "name":    "汇总检测结果",
        "script":  "st_inspect_summarize",
        "timeoutMs": 1000,
        "isCheckpoint": true
      },
      {
        "_comment": "将检测结果发送到下料工位通道",
        "type":   "sync.channel_send",
        "name":   "发送检测结果",
        "timeoutMs": 10000,
        "params": {
          "channel": "ch-inspect-to-unload",
          "ctxKey":  "inspect_result"
        }
      }
    ]
  }
}
